{
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "jsx": "react-jsx",
    "lib": ["DOM", "ES2022"],
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "outDir": "dist/react",
    "rootDir": "react",
    "strict": true,
    "target": "ES2022",
    "skipLibCheck": true
  },
  "include": ["react/**/*.ts", "react/**/*.tsx", "react/**/*.d.ts"]
}
