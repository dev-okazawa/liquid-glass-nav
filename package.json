{
  "name": "@dev-okazawa/liquid-glass-nav",
  "version": "1.1.0",
  "description": "Liquid Glass-style mobile top nav, bottom tab bar, and hamburger drawer components.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dev-okazawa/liquid-glass-nav.git"
  },
  "homepage": "https://github.com/dev-okazawa/liquid-glass-nav#readme",
  "bugs": {
    "url": "https://github.com/dev-okazawa/liquid-glass-nav/issues"
  },
  "files": [
    "dist",
    "style.css",
    "vanilla",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./style.css": "./dist/style.css",
    "./vanilla/index.html": "./vanilla/index.html",
    "./vanilla/script.js": "./vanilla/script.js"
  },
  "types": "./dist/react/index.d.ts",
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && cp style.css dist/style.css",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "typescript": "^6.0.2"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "keywords": [
    "liquid-glass",
    "navigation",
    "react",
    "css",
    "mobile-nav",
    "bottom-nav",
    "hamburger-menu"
  ]
}
